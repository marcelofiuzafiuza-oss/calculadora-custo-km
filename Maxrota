    // ==========================================================================
    // ABA "HOJE" — ENTRADAS / SAÍDAS / RESUMO
    // ==========================================================================
    async function registrarEntrada(origem) {
      const inputValor = document.getElementById('input-entrada-valor');
      const inputCorridas = document.getElementById('input-entrada-corridas');
      const valor = moedaParaNumero(inputValor.value);
      let corridas = parseInt(inputCorridas.value) || 1;

      if (isNaN(valor) || valor <= 0) {
        alert("Por favor, digite um valor válido para a receita.");
        return;
      }

      const novoLancamento = {
        id: Date.now().toString(),
        tipo: 'entrada',
        categoria: origem,
        valor: valor,
        corridas: CANAIS_CORRIDA.includes(origem) ? corridas : 0,
        data: dataSelecionada
      };

      // Limpa os campos IMEDIATAMENTE, antes de qualquer salvamento/render
      inputValor.value = '';
      inputCorridas.value = '1';

      todosLancamentos.push(novoLancamento);
      atualizarPainelHoje();
      graficosDesatualizados = true;
      storageSet('lancamentos', todosLancamentos);
    }

