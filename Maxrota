<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MAX ROTA — Gestão para Motoristas</title>
  
  <!-- Tipografia Oficial: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Ícones Lucide -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Chart.js para Gráficos -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* ==========================================================================
       MAX ROTA — DESIGN SYSTEM V1.0 (TOKENS CSS)
       ========================================================================== */
    :root {
      /* Estrutura */
      --fundo-max: #F4F7FC;
      --branco: #FFFFFF;
      --texto-principal: #111827;
      --texto-secundario: #667085;
      --texto-desabilitado: #98A2B3;
      --linha: #E4E7EC;

      /* Cores da Marca */
      --max-blue: #2878E8;
      --max-cyan: #18B8D0;
      --max-green: #12B981;
      --max-purple: #7C4DFF;
      --max-orange: #FF7412;
      --max-red: #F04444;
      --max-yellow: #FFC814;
      --max-navy: #111827;

      /* Gradientes */
      --grad-principal: linear-gradient(135deg, #12B981 0%, #2878E8 100%);
      --grad-blue: linear-gradient(135deg, #18B8D0 0%, #2878E8 100%);
      --grad-purple: linear-gradient(135deg, #8B5CF6 0%, #6750E8 100%);
      --grad-orange: linear-gradient(135deg, #FF8A00 0%, #FF6500 100%);
      --grad-sunset: linear-gradient(135deg, #FF7412 0%, #F04444 100%);
      --grad-green: linear-gradient(135deg, #12B981 0%, #36D399 100%);
      --grad-dark: linear-gradient(135deg, #111827 0%, #1F2937 100%);

      /* Sombras */
      --sombra-card: 0 10px 30px rgba(17, 24, 39, 0.08);
      --sombra-card-elevado: 0 16px 40px rgba(17, 24, 39, 0.12);
      --sombra-botao-colorido: 0 8px 22px rgba(40, 120, 232, 0.22);

      /* Arredondamentos */
      --radius-sm: 12px;
      --radius-md: 16px;
      --radius-lg: 20px;
      --radius-card-sm: 22px;
      --radius-card: 28px;
      --radius-card-hero: 30px;
      --radius-botao: 18px;
      --radius-pill: 999px;

      --fonte-padrao: 'Inter', system-ui, -apple-system, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--fonte-padrao);
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--fundo-max);
      color: var(--texto-principal);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      padding: 16px 16px 80px 16px;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* ==========================================================================
       CABEÇALHO
       ========================================================================== */
    .header-card {
      background: var(--branco);
      border-radius: var(--radius-card);
      padding: 18px 20px;
      box-shadow: var(--sombra-card);
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .header-logo {
      width: 64px;
      height: 64px;
      border-radius: var(--radius-md);
      background: var(--grad-dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--branco);
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(17, 24, 39, 0.15);
    }

    .header-logo .logo-brand {
      font-weight: 800;
      font-size: 12px;
      background: var(--grad-principal);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header-logo .logo-sub {
      font-size: 9px;
      font-weight: 700;
      color: #94A3B8;
    }

    .header-title { font-size: 20px; font-weight: 800; line-height: 1.1; }
    .header-subtitle { font-size: 12px; font-weight: 500; color: var(--texto-secundario); margin-top: 2px; }

    /* ==========================================================================
       ABAS DE NAVEGAÇÃO DESLIZANTES
       ========================================================================== */
    .tabs-wrapper {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 4px;
    }
    .tabs-wrapper::-webkit-scrollbar { display: none; }

    .tabs-container {
      display: inline-flex;
      background-color: #E2E8F0;
      padding: 4px;
      border-radius: var(--radius-pill);
      gap: 4px;
      min-width: max-content;
    }

    .tab-item {
      padding: 12px 16px;
      min-height: 44px;
      border-radius: var(--radius-pill);
      border: none;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      background: transparent;
      color: var(--texto-secundario);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 6px;
      touch-action: manipulation;
    }

    .tab-item.active {
      background: var(--texto-principal);
      color: var(--branco);
      box-shadow: 0 4px 12px rgba(17, 24, 39, 0.15);
    }

    /* ==========================================================================
       PAINÉIS DE CONTEÚDO
       ========================================================================== */
    .tab-content { display: none; flex-direction: column; gap: 18px; }
    .tab-content.active { display: flex; }

    /* ==========================================================================
       CARDS E COMPONENTES
       ========================================================================== */
    .card-hero {
      background: var(--branco);
      border-radius: var(--radius-card-hero);
      padding: 22px;
      box-shadow: var(--sombra-card-elevado);
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(228, 231, 236, 0.6);
    }

    .card-hero::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
      background: var(--grad-principal);
    }

    .card-standard {
      background: var(--branco);
      border-radius: var(--radius-card);
      padding: 20px;
      box-shadow: var(--sombra-card);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .section-title { font-size: 18px; font-weight: 700; color: var(--texto-principal); }
    .section-sub { font-size: 12px; color: var(--texto-secundario); margin-top: -8px; }

    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .card-small {
      background: var(--branco);
      border-radius: var(--radius-card-sm);
      padding: 16px;
      box-shadow: var(--sombra-card);
      display: flex; flex-direction: column; gap: 6px;
    }

    .icon-box {
      width: 36px; height: 36px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center; color: var(--branco);
    }
    .icon-box.green { background: var(--grad-green); }
    .icon-box.orange { background: var(--grad-orange); }
    .icon-box.blue { background: var(--grad-blue); }
    .icon-box.purple { background: var(--grad-purple); }

    /* FORMULÁRIOS E BOTÕES */
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-label { font-size: 12px; font-weight: 600; color: var(--texto-principal); }
    .input-field, .select-field {
      width: 100%; height: 48px; background: var(--branco);
      border: 1px solid var(--linha); border-radius: var(--radius-md);
      padding: 0 14px; font-size: 14px; font-weight: 500; color: var(--texto-principal);
      outline: none; transition: all 0.2s ease;
    }
    .input-field:focus, .select-field:focus { border-color: var(--max-blue); box-shadow: 0 0 0 3px rgba(40, 120, 232, 0.10); }

    .btn {
      width: 100%; height: 50px; border-radius: var(--radius-botao);
      font-size: 14px; font-weight: 700; display: inline-flex;
      align-items: center; justify-content: center; gap: 8px;
      cursor: pointer; border: none; transition: all 0.15s ease;
    }
    .btn:active { transform: scale(0.97); }
    .btn-primary { background: var(--grad-principal); color: var(--branco); box-shadow: var(--sombra-botao-colorido); }

    /* ==========================================================================
       ESTILO DOS BOTÕES ESTILO FOTO (ENTRADAS E SAÍDAS)
       ========================================================================== */
    .chips-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 6px;
    }

    .btn-custom {
      height: 52px;
      border: none;
      border-radius: 18px;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    .btn-custom:active {
      transform: scale(0.96);
      opacity: 0.9;
    }

    /* CORES DE ENTRADAS (IGUAL À FOTO) */
    .btn-uber { background-color: #0A0D14; color: #FFFFFF; }
    .btn-99 { background-color: #FCD535; color: #111827; }
    .btn-indrive { background-color: #00B175; color: #FFFFFF; }
    .btn-particular { background-color: #5B8BF7; color: #FFFFFF; }
    .btn-loja { background-color: #0052FF; color: #FFFFFF; }
    .btn-doacao { background-color: #6C2BD9; color: #FFFFFF; }

    /* CORES DE SAÍDAS (IGUAL À FOTO) */
    .btn-combustivel { background-color: #FF3B30; color: #FFFFFF; }
    .btn-alimentacao { background-color: #8B5CF6; color: #FFFFFF; }
    .btn-manutencao { background-color: #8E9BAE; color: #FFFFFF; }
    .btn-lavacar { background-color: #0284C7; color: #FFFFFF; }
    .btn-outros { background-color: #475569; color: #FFFFFF; }

    /* ESTILOS DA TABELA DE HOJE */
    .tabela-hoje {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .tabela-hoje th {
      text-align: left;
      padding: 8px;
      color: var(--texto-secundario);
      font-weight: 600;
      border-bottom: 1px solid var(--linha);
    }

    .tabela-hoje td {
      padding: 10px 8px;
      border-bottom: 1px solid var(--linha);
      vertical-align: middle;
    }

    .btn-delete-row {
      background: rgba(240, 68, 68, 0.1);
      color: var(--max-red);
      border: none;
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .btn-delete-row:hover {
      background: var(--max-red);
      color: var(--branco);
    }

    /* ==========================================================================
       PLAYER DE RÁDIO (ABA 1)
       ========================================================================== */
    .radio-player-card {
      background: var(--grad-dark);
      color: white;
      border-radius: var(--radius-card-hero);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: var(--sombra-card-elevado);
    }

    .radio-now-playing {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .radio-cover {
      width: 56px;
      height: 56px;
      border-radius: var(--radius-md);
      background: var(--grad-principal);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .radio-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-play {
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--max-green); color: white;
      display: flex; align-items: center; justify-content: center;
      border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(18, 185, 129, 0.4);
    }

    .radio-station-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px;
      border-radius: var(--radius-md);
      border: 1px solid var(--linha);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .radio-station-item:hover, .radio-station-item.active {
      border-color: var(--max-blue);
      background: rgba(40, 120, 232, 0.05);
    }

    /* LISTAS E TABELAS DE DADOS */
    .item-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 0; border-bottom: 1px solid var(--linha);
    }
    .item-row:last-child { border-bottom: none; }

    .badge {
      display: inline-flex; padding: 4px 10px; border-radius: var(--radius-pill);
      font-size: 11px; font-weight: 700;
    }
    .badge-blue { background: rgba(40, 120, 232, 0.12); color: var(--max-blue); }
    .badge-green { background: rgba(18, 185, 129, 0.12); color: var(--max-green); }
    .badge-orange { background: rgba(255, 116, 18, 0.12); color: var(--max-orange); }

    .chart-box { position: relative; width: 100%; height: 200px; }

    /* BOTÃO FLUTUANTE DE AÇÃO (FAB) */
    .fab-button {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--grad-blue);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 300;
      border: none;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(24, 184, 208, 0.4);
      transition: transform 0.2s ease, opacity 0.2s ease;
      z-index: 100;
    }
    .fab-button:active { transform: scale(0.92); }

    /* ========================================================================
       TELA DE ABERTURA (SPLASH SCREEN)
       ======================================================================== */
    .splash-screen {
      position: fixed;
      inset: 0;
      background: #0A0E17;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.6s ease;
    }
    .splash-screen.splash-oculto {
      opacity: 0;
      pointer-events: none;
    }
    .splash-logo-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform: scale(0.25);
      opacity: 0;
      animation: splashCresce 1.3s cubic-bezier(0.22, 1.4, 0.36, 1) forwards;
    }
    .splash-logo-brand {
      font-weight: 800;
      font-size: min(20vw, 90px);
      line-height: 0.95;
      background: var(--grad-principal);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 1px;
    }
    .splash-logo-sub {
      font-weight: 700;
      font-size: min(9vw, 40px);
      color: white;
      letter-spacing: 6px;
      margin-top: 2px;
    }
    .splash-logo-tagline {
      margin-top: 18px;
      font-size: 13px;
      font-weight: 600;
      color: #6B7280;
      letter-spacing: 1px;
      opacity: 0;
      animation: splashApareceTagline 0.6s ease 1.0s forwards;
    }
    @keyframes splashCresce {
      0%   { transform: scale(0.25); opacity: 0; }
      60%  { transform: scale(1.08); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes splashApareceTagline {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fab-button.aberto { transform: rotate(45deg); }

    .fab-menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.35);
      z-index: 98;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .fab-menu-overlay.aberto { opacity: 1; pointer-events: auto; }

    .fab-menu {
      position: fixed;
      bottom: 92px;
      right: 24px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      z-index: 99;
      pointer-events: none; /* fechado, essa área não pode bloquear toques na tela por trás */
    }
    .fab-menu.aberto {
      pointer-events: auto;
    }
    .fab-menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--fundo-cartao, #fff);
      border: none;
      border-radius: var(--radius-pill);
      padding: 10px 16px 10px 14px;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.18);
      font-size: 13px;
      font-weight: 700;
      color: var(--texto-principal);
      cursor: pointer;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.18s ease, transform 0.18s ease;
      pointer-events: none;
    }
    .fab-menu.aberto .fab-menu-item {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .fab-menu-item .icone-fab {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      flex-shrink: 0;
    }

    /* ESTILOS ESPECÍFICOS PARA A ABA DE DESPESAS */
    .btn-status-pago {
      border: none;
      padding: 6px 12px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-status-pago.pago {
      background: rgba(18, 185, 129, 0.15);
      color: var(--max-green);
    }
    .btn-status-pago.pendente {
      background: rgba(255, 116, 18, 0.15);
      color: var(--max-orange);
    }

    /* BLOQUEIO VISUAL PARA DIA FINALIZADO */
    .dia-bloqueado {
      opacity: 0.5;
      pointer-events: none;
    }

    /* ALERTA DE CONTAS VENCENDO */
    .alerta-despesa {
      background: #FFFBEB;
      border: 1px solid #FCD34D;
      border-radius: var(--radius-md);
      padding: 12px 14px;
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 4px;
    }
  </style>
</head>
<body>

  <!-- TELA DE ABERTURA (SPLASH) -->
  <div class="splash-screen" id="splash-screen">
    <div class="splash-logo-box">
      <span class="splash-logo-brand">MAX</span>
      <span class="splash-logo-sub">ROTA</span>
      <span class="splash-logo-tagline">GESTÃO PARA MOTORISTAS</span>
    </div>
  </div>
  <script>
    // Proteção: se algo impedir o carregamento normal, o splash some sozinho depois de 5s
    setTimeout(() => {
      const el = document.getElementById('splash-screen');
      if (el) el.classList.add('splash-oculto');
    }, 5000);
  </script>

  <!-- ELEMENTO DE ÁUDIO OCULTO PARA REPRODUÇÃO DA RÁDIO -->
  <audio id="audio-player" src="https://live.hunter.fm/pop_high"></audio>

  <main class="app-container">

    <!-- CABEÇALHO PRINCIPAL -->
    <header class="header-card">
      <div class="header-logo">
        <i data-lucide="navigation" size="22" style="margin-bottom: 2px;"></i>
        <span class="logo-brand">MAX</span>
        <span class="logo-sub">ROTA</span>
      </div>
      <div>
        <h1 class="header-title">MAX ROTA</h1>
        <p class="header-subtitle">Gestão para Motoristas</p>
      </div>
    </header>

    <!-- NAVEGAÇÃO COMPLETA COM AS 7 ABAS -->
    <div class="tabs-wrapper">
      <nav class="tabs-container">
        <button class="tab-item active" onclick="switchTab('radio', this)"><i data-lucide="radio" size="15"></i> Rádio</button>
        <button class="tab-item" onclick="switchTab('metas', this)"><i data-lucide="target" size="15"></i> Metas</button>
        <button class="tab-item" onclick="switchTab('hoje', this)"><i data-lucide="layout-dashboard" size="15"></i> Hoje</button>
        <button class="tab-item" onclick="switchTab('analise', this)"><i data-lucide="line-chart" size="15"></i> Gráficos</button>
        <button class="tab-item" onclick="switchTab('historico', this)"><i data-lucide="history" size="15"></i> Análise</button>
        <button class="tab-item" onclick="switchTab('despesas', this)"><i data-lucide="wallet" size="15"></i> Despesas</button>
        <button class="tab-item" onclick="switchTab('reserva', this)"><i data-lucide="piggy-bank" size="15"></i> Reserva</button>
        <button class="tab-item" onclick="switchTab('servicos', this)"><i data-lucide="wrench" size="15"></i> Serv. Veículo</button>
        <button class="tab-item" onclick="switchTab('config-veiculo', this)"><i data-lucide="calculator" size="15"></i> Config. Veículo (Custo/KM)</button>
      </nav>
    </div>

    <!-- ==========================================================================
         ABA 1: RÁDIO MAX ROTA (Sintonizador & Emissoras)
         ========================================================================== -->
    <div id="tab-radio" class="tab-content active">
      
      <div class="radio-player-card">
        <div class="radio-now-playing">
          <div class="radio-cover">
            <i data-lucide="radio" size="28"></i>
          </div>
          <div>
            <span style="font-size: 11px; color: var(--max-green); font-weight: 700; text-transform: uppercase;">Ao Vivo • Tocando Agora</span>
            <h3 id="current-radio-title" style="font-size: 18px; font-weight: 800;">Hunter.FM — Top Hits</h3>
            <p id="current-radio-sub" style="font-size: 12px; color: #94A3B8;">Parceira Oficial MAX ROTA</p>
          </div>
        </div>

        <div class="radio-controls">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i data-lucide="volume-2" size="18" style="color: #94A3B8;"></i>
            <span style="font-size: 12px; color: #94A3B8;">Transmissão Digital</span>
          </div>
          <button class="btn-play" id="btn-play-radio" onclick="togglePlayState()">
            <i data-lucide="play" size="22" style="font-size: 18px; font-style: normal;">▶</i>
          </button>
        </div>
      </div>

      <section class="card-standard">
        <h2 class="section-title">Estações Disponíveis</h2>
        <p class="section-sub">Selecione sua rádio preferida para acompanhar sua jornada</p>

        <div style="display: flex; flex-direction: column; gap: 10px;" id="lista-estacoes-radio">
          <!-- Renderizado dinamicamente por renderEstacoesRadio() -->
        </div>
      </section>

    </div>

