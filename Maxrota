    async function alternarFinalizarDia() {
      diasFinalizados[dataSelecionada] = !diasFinalizados[dataSelecionada];
      await storageSet('dias-finalizados', diasFinalizados);
      atualizarPainelHoje();
    }

    function aplicarBloqueioDia(finalizado) {
      const secoes = ['secao-horas', 'secao-entradas', 'secao-passes', 'secao-saidas'];
      secoes.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('dia-bloqueado', finalizado);
      });
      const btn = document.getElementById('btn-finalizar-dia');
      if (finalizado) {
        btn.innerHTML = '<i data-lucide="unlock" size="16"></i> Reabrir o Dia';
        btn.style.background = '#E2E8F0';
        btn.style.color = 'var(--texto-secundario)';
        btn.style.boxShadow = 'none';
      } else {
        btn.innerHTML = '<i data-lucide="lock" size="16"></i> Finalizar o Dia';
        btn.style.background = '';
        btn.style.color = '';
        btn.style.boxShadow = '';
      }
