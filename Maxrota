    async function salvarHorasHoje() {
      const input = document.getElementById('input-horas-hoje');
      const horas = parseFloat(input.value);
      if (isNaN(horas) || horas < 0) {
        alert('Digite um número de horas válido.');
        return;
      }
      input.value = '';
      horasPorDia[dataSelecionada] = horas;
      atualizarPainelHoje();
      graficosDesatualizados = true;
      storageSet('horas', horasPorDia);
