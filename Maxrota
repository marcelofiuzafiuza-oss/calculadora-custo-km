    function atualizarPainelHoje() {
      const hoje = dataSelecionada;
      const ehHoje = hoje === getDataHojeISO();
      const lancamentosHoje = todosLancamentos.filter(l => l.data === hoje);
      const dataFormatadaTitulo = ehHoje ? 'Hoje' : new Date(hoje + 'T00:00:00').toLocaleDateString('pt-BR');

      document.getElementById('titulo-horas').innerText = ehHoje ? 'Horas Trabalhadas Hoje' : `Horas Trabalhadas — ${dataFormatadaTitulo}`;
      document.getElementById('titulo-resumo').innerText = ehHoje ? 'Resumo do Dia (Hoje)' : `Resumo do Dia — ${dataFormatadaTitulo}`;
      document.getElementById('titulo-lancamentos').innerText = ehHoje ? 'Lançamentos do Dia' : `Lançamentos — ${dataFormatadaTitulo}`;

      let totalEntradas = 0;
      let totalSaidas = 0;
      const entradasMap = {};
      const saidasMap = {};

      lancamentosHoje.forEach(item => {
        if (item.tipo === 'entrada') {
          totalEntradas += item.valor;
          entradasMap[item.categoria] = (entradasMap[item.categoria] || 0) + item.valor;
        } else if (item.tipo === 'saida') {
          totalSaidas += item.valor;
          saidasMap[item.categoria] = (saidasMap[item.categoria] || 0) + item.valor;
        }
      });

      const saldoLiquido = totalEntradas - totalSaidas;

      document.getElementById('resumo-total-entradas').innerText = formatarMoeda(totalEntradas);
      document.getElementById('resumo-total-saidas').innerText = formatarMoeda(totalSaidas);

      const elSaldo = document.getElementById('resumo-saldo-liquido');
      elSaldo.innerText = formatarMoeda(saldoLiquido);
      elSaldo.style.color = saldoLiquido >= 0 ? 'var(--max-blue)' : 'var(--max-red)';

      const detalheEntradasArr = Object.keys(entradasMap).map(cat => `${cat} (${formatarMoeda(entradasMap[cat])})`);
      document.getElementById('resumo-detalhe-entradas').innerText = detalheEntradasArr.length > 0
        ? `Detalhamento: ${detalheEntradasArr.join(' | ')}`
        : 'Detalhamento: Nenhum lançamento';

      const detalheSaidasArr = Object.keys(saidasMap).map(cat => `${cat} (${formatarMoeda(saidasMap[cat])})`);
      document.getElementById('resumo-detalhe-saidas').innerText = detalheSaidasArr.length > 0
        ? `Detalhamento: ${detalheSaidasArr.join(' | ')}`
        : 'Detalhamento: Nenhum lançamento';

      // Horas do dia selecionado e R$/hora (campo sempre limpo após salvar)
      const horasHoje = horasPorDia[hoje] || 0;
      document.getElementById('display-horas-hoje').innerText = `${horasHoje}h`;
      const inputHoras = document.getElementById('input-horas-hoje');
      inputHoras.value = '';
      inputHoras.placeholder = horasHoje > 0 ? `Atual: ${horasHoje}h — digite p/ atualizar` : 'Ex: 8';
      const rsHora = horasHoje > 0 ? saldoLiquido / horasHoje : 0;
      document.getElementById('resumo-rs-hora').innerText = `${formatarMoeda(rsHora)}/h`;

      // Tabela de lançamentos
      const tabelaBody = document.getElementById('tabela-lancamentos-hoje');
      if (lancamentosHoje.length === 0) {
        tabelaBody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: var(--texto-secundario); padding: 12px;">Nenhum lançamento registrado nesta data.</td></tr>`;
      } else {
        tabelaBody.innerHTML = lancamentosHoje.map(item => `
          <tr>
            <td>
              <span class="badge ${item.tipo === 'entrada' ? 'badge-green' : 'badge-orange'}">
                ${item.tipo === 'entrada' ? 'Entrada' : 'Saída'}
              </span>
            </td>
            <td style="font-weight: 600;">${item.categoria}${item.corridas ? ` <span style="color:var(--texto-secundario); font-weight:500;">(${item.corridas} corrida${item.corridas > 1 ? 's' : ''})</span>` : ''}</td>
            <td style="font-weight: 700; color: ${item.tipo === 'entrada' ? 'var(--max-green)' : 'var(--max-red)'};">
              ${formatarMoeda(item.valor)}
            </td>
            <td style="text-align: center;">
              <button class="btn-delete-row" onclick="excluirLancamentoHoje('${item.id}')" title="Excluir">
                <i data-lucide="trash-2" size="14"></i>
              </button>
            </td>
          </tr>
        `).join('');
      }

      aplicarBloqueioDia(!!diasFinalizados[hoje]);
      criarIconesSeguro();
    }

    // ==========================================================================
    // ABA HISTÓRICO — FECHAMENTO E COMPARATIVO MENSAL
    // ==========================================================================
    function calcularFechamentoMes(mesAno) {
      const entradasMes = todosLancamentos.filter(l => l.tipo === 'entrada' && mesAnoDeData(l.data) === mesAno);
      const saidasMes = todosLancamentos.filter(l => l.tipo === 'saida' && mesAnoDeData(l.data) === mesAno);
      const faturamento = entradasMes.reduce((a, l) => a + l.valor, 0);
      const custos = saidasMes.reduce((a, l) => a + l.valor, 0);
      const lucro = faturamento - custos;
      const corridas = entradasMes.reduce((a, l) => a + (l.corridas || 0), 0);
      const horas = Object.keys(horasPorDia).filter(d => mesAnoDeData(d) === mesAno).reduce((a, d) => a + horasPorDia[d], 0);

      const porDia = {};
      entradasMes.forEach(l => { porDia[l.data] = (porDia[l.data] || 0) + l.valor; });
      const diasArr = Object.keys(porDia).map(data => ({ data, valor: porDia[data] })).sort((a, b) => b.valor - a.valor);

      const porApp = {};
      entradasMes.forEach(l => {
        porApp[l.categoria] = porApp[l.categoria] || { total: 0, qtd: 0 };
        porApp[l.categoria].total += l.valor;
        porApp[l.categoria].qtd += (l.corridas || 0);
      });

      // Maiores gastos do mês — passes de todos os apps somados numa única categoria
      const porCategoriaGasto = {};
      saidasMes.forEach(l => {
        const chave = l.categoria.startsWith('Passe') ? 'Passes Diários (99, Uber, inDriver, Outros)' : l.categoria;
        porCategoriaGasto[chave] = (porCategoriaGasto[chave] || 0) + l.valor;
      });
      const maioresGastos = Object.keys(porCategoriaGasto)
        .map(categoria => ({ categoria, total: porCategoriaGasto[categoria] }))
        .sort((a, b) => b.total - a.total);

      return { faturamento, custos, lucro, corridas, horas, diasArr, porApp, maioresGastos };
    }

    let mesHistoricoSelecionado = getMesAnoAtual(); // fonte confiável — não depende só do <input type="month">

    function renderHistorico() {
      const inputMes = document.getElementById('historico-filtro-mes');
      const valorInput = inputMes.value;
      if (valorInput) mesHistoricoSelecionado = valorInput;
      inputMes.value = mesHistoricoSelecionado;
      const mesAno = mesHistoricoSelecionado;

      const fechamento = calcularFechamentoMes(mesAno);
      document.getElementById('hist-faturamento').innerText = formatarMoeda(fechamento.faturamento);
      document.getElementById('hist-lucro').innerText = formatarMoeda(fechamento.lucro);
      document.getElementById('hist-corridas').innerText = fechamento.corridas;
      document.getElementById('hist-horas').innerText = `${fechamento.horas}h`;
      document.getElementById('hist-rs-hora').innerText = fechamento.horas > 0 ? formatarMoeda(fechamento.faturamento / fechamento.horas) : 'R$ 0,00';
      document.getElementById('hist-rs-corrida').innerText = fechamento.corridas > 0 ? formatarMoeda(fechamento.faturamento / fechamento.corridas) : 'R$ 0,00';

      // Comparativo com mês anterior
      const [ano, mes] = mesAno.split('-').map(Number);
      const dataAnterior = new Date(ano, mes - 2, 1);
      const mesAnteriorKey = `${dataAnterior.getFullYear()}-${String(dataAnterior.getMonth() + 1).padStart(2, '0')}`;
      const fechamentoAnterior = calcularFechamentoMes(mesAnteriorKey);

      const linhasComparativo = [
        { label: 'Faturamento', atual: fechamento.faturamento, anterior: fechamentoAnterior.faturamento },
        { label: 'Lucro Líquido', atual: fechamento.lucro, anterior: fechamentoAnterior.lucro },
        { label: 'Corridas', atual: fechamento.corridas, anterior: fechamentoAnterior.corridas, moeda: false },
        { label: 'Horas', atual: fechamento.horas, anterior: fechamentoAnterior.horas, moeda: false }
      ];

      document.getElementById('hist-comparativo').innerHTML = linhasComparativo.map(l => {
        const variacao = l.anterior !== 0 ? ((l.atual - l.anterior) / Math.abs(l.anterior)) * 100 : (l.atual > 0 ? 100 : 0);
        const corVariacao = variacao >= 0 ? 'var(--max-green)' : 'var(--max-red)';
        const valorAtualFmt = l.moeda === false ? l.atual : formatarMoeda(l.atual);
        const valorAnteriorFmt = l.moeda === false ? l.anterior : formatarMoeda(l.anterior);
        return `
          <div class="item-row">
            <div>
              <span style="font-size: 13px; font-weight: 600;">${l.label}</span>
              <p style="font-size: 11px; color: var(--texto-secundario);">Mês anterior: ${valorAnteriorFmt}</p>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 14px; font-weight: 800;">${valorAtualFmt}</span>
              <p style="font-size: 11px; font-weight: 700; color: ${corVariacao};">${variacao >= 0 ? '+' : ''}${variacao.toFixed(0)}%</p>
            </div>
          </div>`;
      }).join('');

      // Distribuição por app
      const appsArr = Object.keys(fechamento.porApp).map(cat => ({ categoria: cat, ...fechamento.porApp[cat] }))
        .sort((a, b) => b.total - a.total);
      document.getElementById('hist-apps').innerHTML = appsArr.length === 0
        ? `<p style="font-size: 13px; color: var(--texto-secundario); text-align: center; padding: 8px 0;">Sem corridas lançadas neste mês.</p>`
        : appsArr.map(a => `
          <div class="item-row">
            <span style="font-size: 13px; font-weight: 600;">${a.categoria}${a.qtd ? ` (${a.qtd} corridas)` : ''}</span>
            <span style="font-size: 14px; font-weight: 800; color: var(--max-green);">${formatarMoeda(a.total)}</span>
          </div>
        `).join('');

      // Melhores e piores dias
      const melhores = fechamento.diasArr.slice(0, 3);
      const piores = [...fechamento.diasArr].reverse().slice(0, 3);
      const renderDiaItem = (d) => `
        <div class="item-row" style="padding: 8px 0;">
          <span style="font-size: 12px; color: var(--texto-secundario);">${new Date(d.data + 'T00:00:00').toLocaleDateString('pt-BR')}</span>
          <span style="font-size: 13px; font-weight: 700;">${formatarMoeda(d.valor)}</span>
        </div>`;
      document.getElementById('hist-melhores-dias').innerHTML = melhores.length
        ? melhores.map(renderDiaItem).join('') : `<p style="font-size: 12px; color: var(--texto-secundario);">Sem dados</p>`;
      document.getElementById('hist-piores-dias').innerHTML = piores.length
        ? piores.map(renderDiaItem).join('') : `<p style="font-size: 12px; color: var(--texto-secundario);">Sem dados</p>`;

      // Maiores gastos do mês (com passes de todos os apps somados numa categoria só)
      document.getElementById('hist-maiores-gastos').innerHTML = fechamento.maioresGastos.length
        ? fechamento.maioresGastos.map((g, i) => `
          <div class="item-row">
            <span style="font-size: 13px; font-weight: 600;">${i + 1}º — ${g.categoria}</span>
            <span style="font-size: 14px; font-weight: 800; color: var(--max-red);">${formatarMoeda(g.total)}</span>
          </div>`).join('')
        : `<p style="font-size: 13px; color: var(--texto-secundario); text-align: center; padding: 8px 0;">Nenhum gasto lançado neste mês.</p>`;
    }

    // ==========================================================================
    // METAS (DIÁRIA E SEMANAL)
    // ==========================================================================
    async function salvarMetas() {
      metas.diaria = moedaParaNumero(document.getElementById('input-meta-diaria').value);
      metas.semanal = moedaParaNumero(document.getElementById('input-meta-semanal').value);
      await storageSet('metas', metas);
      renderProgressoMetas();
    }

    function renderProgressoMetas() {
      const hoje = getDataHojeISO();
      const entradas = todosLancamentos.filter(l => l.tipo === 'entrada');
      const faturamentoHoje = entradas.filter(l => l.data === hoje).reduce((a, l) => a + l.valor, 0);

      const d = new Date();
      const dow = d.getDay();
      const mondayOffset = dow === 0 ? 6 : dow - 1;
      const segunda = new Date(d);
      segunda.setDate(d.getDate() - mondayOffset);
      const segundaISO = segunda.toISOString().split('T')[0];
      const faturamentoSemana = entradas.filter(l => l.data >= segundaISO && l.data <= hoje).reduce((a, l) => a + l.valor, 0);

      const pctDiario = metas.diaria > 0 ? Math.min(100, (faturamentoHoje / metas.diaria) * 100) : 0;
      const pctSemanal = metas.semanal > 0 ? Math.min(100, (faturamentoSemana / metas.semanal) * 100) : 0;

      document.getElementById('texto-progresso-diario').innerText = `${formatarMoeda(faturamentoHoje)} / ${formatarMoeda(metas.diaria)}`;
      document.getElementById('barra-progresso-diario').style.width = `${pctDiario}%`;
      document.getElementById('texto-progresso-semanal').innerText = `${formatarMoeda(faturamentoSemana)} / ${formatarMoeda(metas.semanal)}`;
      document.getElementById('barra-progresso-semanal').style.width = `${pctSemanal}%`;
    }

    // ==========================================================================
    // ABA ANÁLISE — GRÁFICOS DINÂMICOS
    // ==========================================================================
    let chartEvolucaoInstance, chartPlataformasInstance, chartCorridasAppInstance,
        chartFaturamentoMensalInstance, chartHorasMensalInstance, chartAppMensalInstance,
        chartDiaSemanaInstance, chartSemanaComparativoInstance;

    function ultimosNDias(n) {
      const dias = [];
      for (let i = n - 1; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        dias.push(d.toISOString().split('T')[0]);
      }
      return dias;
    }

    function ultimosNMeses(n) {
      const meses = [];
      const d = new Date();
      d.setDate(1);
      for (let i = n - 1; i >= 0; i--) {
        const dm = new Date(d.getFullYear(), d.getMonth() - i, 1);
        const m = String(dm.getMonth() + 1).padStart(2, '0');
        meses.push(`${dm.getFullYear()}-${m}`);
      }
      return meses;
    }

    function nomeMesCurto(mesAno) {
      const [ano, mes] = mesAno.split('-');
      const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
      return `${nomes[parseInt(mes) - 1]}/${ano.slice(2)}`;
    }

    function renderGraficosAnalise() {
      // Se a biblioteca de gráficos não carregou (ex: sem internet, CDN bloqueado
      // no navegador/preview), avisa em vez de travar silenciosamente.
      if (typeof Chart === 'undefined') {
        console.error('Chart.js não carregou — verifique a conexão com a internet.');
        const aviso = document.getElementById('aviso-graficos-indisponiveis');
        if (aviso) aviso.style.display = 'block';
        try { renderProgressoMetas(); } catch (e) { console.error(e); }
        return;
      }
      const avisoEl = document.getElementById('aviso-graficos-indisponiveis');
      if (avisoEl) avisoEl.style.display = 'none';

      try {
      const entradas = todosLancamentos.filter(l => l.tipo === 'entrada');
      const mesAtual = getMesAnoAtual();
      const entradasMesAtual = entradas.filter(l => mesAnoDeData(l.data) === mesAtual);

      // --- Stats rápidas ---
      const totalValorMes = entradasMesAtual.reduce((a, l) => a + l.valor, 0);
      const totalCorridasMes = entradasMesAtual.reduce((a, l) => a + (l.corridas || 0), 0);
      const totalHorasMes = Object.keys(horasPorDia)
        .filter(d => mesAnoDeData(d) === mesAtual)
        .reduce((a, d) => a + horasPorDia[d], 0);

      document.getElementById('stat-rs-corrida').innerText = totalCorridasMes > 0
        ? formatarMoeda(totalValorMes / totalCorridasMes) : 'R$ 0,00';
      document.getElementById('stat-rs-hora-mes').innerText = totalHorasMes > 0
        ? formatarMoeda(totalValorMes / totalHorasMes) : 'R$ 0,00';

      // --- Gráfico 1: Faturamento últimos 7 dias ---
      const dias7 = ultimosNDias(7);
      const valoresPorDia = dias7.map(d => entradas.filter(l => l.data === d).reduce((a, l) => a + l.valor, 0));
      const labelsDias7 = dias7.map(d => new Date(d + 'T00:00:00').toLocaleDateString('pt-BR', { weekday: 'short' }));

      if (chartEvolucaoInstance) chartEvolucaoInstance.destroy();
      chartEvolucaoInstance = new Chart(document.getElementById('chartEvolucao').getContext('2d'), {
        type: 'line',
