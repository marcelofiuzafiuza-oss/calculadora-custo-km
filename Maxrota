  <script>
    // ==========================================================================
    // HELPERS DE STORAGE — usa localStorage do navegador (funciona no celular,
    // no GitHub Pages e em qualquer lugar, sem depender de recursos do Claude)
    // ==========================================================================
    const PREFIXO_LOCAL = 'maxrota-';

    async function storageGet(key, fallback) {
      try {
        const raw = localStorage.getItem(PREFIXO_LOCAL + key);
        return raw ? JSON.parse(raw) : fallback;
      } catch (e) {
        console.error('Erro ao ler', key, e);
        return fallback;
      }
    }
    async function storageSet(key, value) {
      try {
        localStorage.setItem(PREFIXO_LOCAL + key, JSON.stringify(value));
      } catch (e) {
        console.error('Erro ao salvar', key, e);
      }
    }

    // Auxiliar de formatação de moeda BRL (R$)
    // Wrapper seguro: se a biblioteca de ícones não carregar (sem internet, CDN
    // bloqueado), isso não pode travar o resto do app.
    function criarIconesSeguro() {
      try {
        if (typeof lucide !== 'undefined') lucide.createIcons();
      } catch (e) {
        console.error('Erro ao criar ícones:', e);
      }
    }

    function formatarMoeda(valor) {
      return (valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // ==========================================================================
    // MÁSCARA DE MOEDA — campos "R$" começam vazios (placeholder "0,00") e o
    // usuário só digita números; a formatação com vírgula é automática.
    // ==========================================================================
    function aplicarMascaraMoeda(input) {
      let digitos = input.value.replace(/\D/g, '');
      if (digitos === '') { input.value = ''; return; }
      digitos = digitos.replace(/^0+(?=\d)/, '');
      while (digitos.length < 3) digitos = '0' + digitos;
      const centavos = digitos.slice(-2);
      let inteiros = digitos.slice(0, -2).replace(/^0+(?=\d)/, '');
      inteiros = inteiros.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      input.value = `${inteiros},${centavos}`;
    }

    function moedaParaNumero(valorFormatado) {
      if (!valorFormatado) return 0;
      const limpo = String(valorFormatado).replace(/\./g, '').replace(',', '.');
      return parseFloat(limpo) || 0;
    }

    function getDataHojeISO() {
      const d = new Date();
      return d.toISOString().split('T')[0];
    }

    function getMesAnoAtual() {
      const d = new Date();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      return `${d.getFullYear()}-${m}`;
    }

    function mesAnoDeData(dataISO) {
      return dataISO.slice(0, 7);
    }

    // ==========================================================================
    // ESTADO GLOBAL EM MEMÓRIA (carregado do storage no window.onload)
    // ==========================================================================
    let todosLancamentos = [];   // {id, tipo, categoria, valor, corridas, data}
    let bancoContas = [];
    let servicos = [];           // {id, nome, km, valor, data}
    let horasPorDia = {};        // { 'YYYY-MM-DD': horasNumero }
    let diasFinalizados = {};    // { 'YYYY-MM-DD': true }
    let metas = { diaria: 0, semanal: 0 };
    let dataSelecionada = getDataHojeISO();
    let graficosDesatualizados = true; // controla se os gráficos da aba Análise precisam ser recalculados
    let reservaPorDia = {}; // { 'YYYY-MM-DD': valorGuardadoNumero }
    let reservaTaxaMensal = 0; // % ao mês, pra simulação de rendimento

    const CANAIS_CORRIDA = ['Uber', '99', 'inDriver'];

    // ==========================================================================
    // SELETOR DE DATA (ABA HOJE)
    // ==========================================================================
    function aoMudarDataSelecionada() {
      const input = document.getElementById('input-data-selecionada');
      dataSelecionada = input.value || getDataHojeISO();
      document.getElementById('btn-voltar-hoje').style.display = dataSelecionada === getDataHojeISO() ? 'none' : 'flex';
